APP_NAME="Domain Checker"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# In production use the rotating channel instead: LOG_CHANNEL=daily,
# LOG_DAILY_DAYS=14, LOG_LEVEL=warning. The checker logs a line per failing
# TLD, so a full-list run at debug level writes thousands of them into a file
# that never rotates.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Sessions, cache and the queue all use the database driver, so a real
# database is required — the app does not run without one.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=domain_checker
DB_USERNAME=root
DB_PASSWORD=
# To use SQLite instead, set DB_CONNECTION=sqlite and DB_DATABASE to an
# absolute path, then create the file first (`touch database/database.sqlite`).
# It is gitignored, so a fresh clone never has one.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Must be true in production: it is what stops the session cookie from ever
# being sent over plain HTTP. Left false here so local http://localhost works.
SESSION_SECURE_COOKIE=false

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Realtime Register IsProxy (optional; leave empty to use the free
# RDAP/WHOIS path). The API key and host can also be set per install in
# Settings -> API Integrations, which takes precedence over these. The port
# is env/config only, so it cannot be changed from the UI.
REALTIME_REGISTER_API_KEY=
REALTIME_REGISTER_HOST=is.yoursrs.com
REALTIME_REGISTER_PORT=2001
